rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read and write access to all files for authenticated users
    // Consider restricting this further based on your app's needs.
    // For example, match /b/{bucket}/o/users/{userId}/{allPaths=**}
    // to allow users to only access their own files.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
